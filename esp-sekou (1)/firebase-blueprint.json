{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Student profile including integration roles.",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "photoUrl": { "type": "string" },
        "department": { "type": "string" },
        "bio": { "type": "string" },
        "hobbies": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin", "super-admin"] },
        "isBureauMember": { "type": "boolean" },
        "bureauRole": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["firstName", "lastName", "department", "role"]
    },
    "Conversation": {
      "title": "Chat Conversation",
      "description": "Group or direct chat sessions.",
      "type": "object",
      "properties": {
        "participantIds": { "type": "array" },
        "type": { "type": "string", "enum": ["direct", "group"] },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "name": { "type": "string" }
      },
      "required": ["participantIds", "type"]
    },
    "Message": {
      "title": "Chat Message",
      "description": "Specific message in a conversation.",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["conversationId", "senderId", "text", "createdAt"]
    },
    "Broadcast": {
      "title": "Broadcast Notification",
      "description": "Admin messages sent to segments of students.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "filterDept": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "text", "createdAt"]
    },
    "Config": {
      "title": "App Configuration",
      "description": "Global toggles for feature phases.",
      "type": "object",
      "properties": {
        "inscriptionOnly": { "type": "boolean" },
        "showValues": { "type": "boolean" },
        "showOath": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual student profiles."
    },
    "/conversations/{convId}": {
      "schema": "Conversation",
      "description": "Active chat threads."
    },
    "/conversations/{convId}/messages/{msgId}": {
      "schema": "Message",
      "description": "Messages within a conversation."
    },
    "/broadcasts/{broadcastId}": {
      "schema": "Broadcast",
      "description": "Global or segmented announcements."
    },
    "/config/global": {
      "schema": "Config",
      "description": "Application feature flags."
    }
  }
}
